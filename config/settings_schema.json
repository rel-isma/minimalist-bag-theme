[
  {
    "name": "theme_info",
    "theme_name": "Atelier Vane",
    "theme_version": "2.0.1",
    "theme_author": "Atelier Vane",
    "theme_documentation_url": "https://github.com/shopify/skeleton-theme",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Base scheme (quiet luxury)"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background (bone)",
        "default": "#F5F1EA"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (stone)",
        "default": "#ECE5DA"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text & primary UI (ink)",
        "default": "#1B1A18"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text (ash)",
        "default": "#6B6258"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (clay)",
        "default": "#9A4F36"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border & line (stone line)",
        "default": "#D9D0C3"
      },
      {
        "type": "header",
        "content": "Inverse scheme"
      },
      {
        "type": "color",
        "id": "color_inverse_bg",
        "label": "Inverse background",
        "default": "#1B1A18"
      },
      {
        "type": "color",
        "id": "color_inverse_text",
        "label": "Inverse text",
        "default": "#F5F1EA"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "garamond_n4"
      },
      {
        "type": "header",
        "content": "Body & interface"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout & spacing",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1440,
        "step": 20,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1320
      }
    ]
  },
  {
    "name": "Product cards and collections",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Card image ratio",
        "options": [
          {
            "value": "3/4",
            "label": "Portrait (3:4)"
          },
          {
            "value": "4/5",
            "label": "Portrait (4:5)"
          },
          {
            "value": "1/1",
            "label": "Square (1:1)"
          }
        ],
        "default": "3/4"
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show color swatches",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Show quick add",
        "default": true
      },
      {
        "type": "select",
        "id": "collection_grid_columns",
        "label": "Desktop products per row",
        "options": [
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "4",
            "label": "4"
          }
        ],
        "default": "3"
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Atelier Vane"
      }
    ]
  },
  {
    "name": "Cart & shipping",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (in store currency)",
        "default": 0,
        "info": "Set a verified threshold in the store base currency. 0 hides the bar. It stays hidden in other presentment currencies to avoid an incorrect shipping promise."
      },
      {
        "type": "checkbox",
        "id": "enable_cart_notes",
        "label": "Enable order notes",
        "default": true
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Recommended: 32x32px .png"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram url"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest url"
      }
    ]
  }
]
