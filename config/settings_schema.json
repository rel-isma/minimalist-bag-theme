[
  {
    "name": "theme_info",
    "theme_name": "Atelier Veyne",
    "theme_version": "2.0.1",
    "theme_author": "Atelier Veyne",
    "theme_documentation_url": "https://github.com/shopify/skeleton-theme",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Base scheme (quiet luxury)"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background (bone)",
        "default": "#F5F1EA"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (stone)",
        "default": "#ECE5DA"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text & primary UI (ink)",
        "default": "#1B1A18"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text (ash)",
        "default": "#6B6258"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (clay)",
        "default": "#9A4F36"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border & line (stone line)",
        "default": "#D9D0C3"
      },
      {
        "type": "header",
        "content": "Inverse scheme"
      },
      {
        "type": "color",
        "id": "color_inverse_bg",
        "label": "Inverse background",
        "default": "#1B1A18"
      },
      {
        "type": "color",
        "id": "color_inverse_text",
        "label": "Inverse text",
        "default": "#F5F1EA"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "garamond_n4"
      },
      {
        "type": "header",
        "content": "Body & interface"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout & spacing",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1440,
        "step": 20,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1320
      }
    ]
  },
  {
    "name": "Product cards and collections",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Card image ratio",
        "options": [
          {
            "value": "3/4",
            "label": "Portrait (3:4)"
          },
          {
            "value": "4/5",
            "label": "Portrait (4:5)"
          },
          {
            "value": "1/1",
            "label": "Square (1:1)"
          }
        ],
        "default": "3/4"
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show color swatches",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Show quick add",
        "default": true
      },
      {
        "type": "select",
        "id": "collection_grid_columns",
        "label": "Desktop products per row",
        "options": [
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "4",
            "label": "4"
          }
        ],
        "default": "3"
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Atelier Veyne"
      }
    ]
  },
  {
    "name": "Cart & shipping",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (in store currency)",
        "default": 0,
        "info": "Set a verified threshold in the store base currency. 0 hides the bar. It stays hidden in other presentment currencies to avoid an incorrect shipping promise."
      },
      {
        "type": "checkbox",
        "id": "enable_cart_notes",
        "label": "Enable order notes",
        "default": true
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Recommended: 32x32px .png"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram url"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest url"
      }
    ]
  },
  {
    "name": "Welcome & offers",
    "settings": [
      {
        "type": "checkbox",
        "id": "offers_enabled",
        "label": "Enable welcome popup and gift button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "welcome_auto_open",
        "label": "Open welcome popup for new visitors",
        "default": true
      },
      {
        "type": "range",
        "id": "welcome_delay",
        "label": "Welcome delay",
        "unit": "s",
        "min": 1,
        "max": 15,
        "step": 1,
        "default": 2
      },
      {
        "type": "range",
        "id": "welcome_frequency",
        "label": "Days before showing welcome again",
        "min": 1,
        "max": 30,
        "step": 1,
        "default": 7
      },
      {
        "type": "image_picker",
        "id": "welcome_image",
        "label": "Welcome image"
      },
      {
        "type": "text",
        "id": "welcome_heading",
        "label": "Welcome heading",
        "default": "Welcome to Atelier Veyne."
      },
      {
        "type": "text",
        "id": "welcome_text",
        "label": "Welcome text",
        "default": "A little something for your everyday. Join our list for private offers, new arrivals and notes from the atelier."
      },
      {
        "type": "text",
        "id": "welcome_button",
        "label": "Signup button",
        "default": "Join the atelier"
      },
      {
        "type": "collection",
        "id": "offers_collection",
        "label": "Wallet choices collection",
        "info": "All available products in this collection can be selected in the bag + wallet offer."
      },
      {
        "type": "header",
        "content": "Welcome discount"
      },
      {
        "type": "paragraph",
        "content": "Create and test the matching Shopify discount before enabling it. Theme settings do not create discounts. The code is shown after Shopify confirms the signup; use an email platform for private or unique codes."
      },
      {
        "type": "checkbox",
        "id": "welcome_discount_enabled",
        "label": "Show configured welcome discount",
        "default": false
      },
      {
        "type": "text",
        "id": "welcome_discount_code",
        "label": "Existing welcome discount code"
      },
      {
        "type": "text",
        "id": "welcome_discount_terms",
        "label": "Welcome offer and conditions",
        "default": "Join for 10% off your first order. One use per customer. Cannot be combined with other discounts."
      },
      {
        "type": "header",
        "content": "Bag pairing offer"
      },
      {
        "type": "checkbox",
        "id": "bundle_offer_enabled",
        "label": "Show configured bag pairing offer",
        "default": false
      },
      {
        "type": "text",
        "id": "bundle_offer_heading",
        "label": "Pairing heading",
        "default": "Add a wallet. Save 10% on your bag."
      },
      {
        "type": "text",
        "id": "bundle_offer_code",
        "label": "Existing pairing discount code"
      },
      {
        "type": "text",
        "id": "bundle_offer_terms",
        "label": "Pairing conditions",
        "default": "Buy a bag with a wallet, cardholder or accessory and use TEST10 for 10% off one bag. One discounted bag per order. Shopify confirms eligibility and final savings."
      },
      {
        "type": "product",
        "id": "offer_bag",
        "label": "Suggested bag",
        "info": "Choose a bag for visitors who do not already have one in their cart."
      },
      {
        "type": "product",
        "id": "offer_wallet",
        "label": "Suggested wallet",
        "info": "Initial suggestion. Customers can switch to other available products from the wallet choices collection."
      }
    ]
  }
]
