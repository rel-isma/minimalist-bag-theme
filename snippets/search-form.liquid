{%- comment -%}Pass input_id and predictive. A standard GET form remains the fallback.{%- endcomment -%}
<div class="atelier-search" {% if predictive %}data-predictive-search data-predictive-url="{{ routes.predictive_search_url }}"{% endif %}>
  <form action="{{ routes.search_url }}" method="get" role="search" class="atelier-search__form">
    <label class="form-label" for="{{ input_id }}">Search products and pages</label>
    <div class="atelier-search__controls">
      <input class="form-input" type="search" name="q" id="{{ input_id }}" value="{{ search.terms | escape }}" placeholder="Search our atelier" {% if predictive %}data-search-input{% endif %}>
      <input type="hidden" name="type" value="product,page">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="btn btn--primary" type="submit">Search</button>
    </div>
  </form>
  {%- if predictive -%}
    <p class="catalog-status" data-search-status role="status" aria-live="polite"></p>
    <div id="{{ input_id }}-results" class="predictive-results" data-search-results role="listbox" aria-label="Search suggestions" hidden></div>
  {%- endif -%}
</div>
