<article class="cart-item" data-cart-item data-item-key="{{ item.key | escape }}"><div class="cart-item__media">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '80px', class: 'cart-item__image', alt: item.title }}</a>{% else %}<div class="cart-item__placeholder-thumb"></div>{% endif %}</div><div class="cart-item__details"><div class="cart-item__header"><a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a><span class="cart-item__price">{{ item.final_line_price | money }}</span></div>{% unless item.product.has_only_default_variant %}<p class="text-muted">{{ item.variant.title | escape }}</p>{% endunless %}{% for allocation in item.line_level_discount_allocations %}{% if allocation.amount > 0 %}<p class="cart-item__discount">{% assign allocation_code = allocation.discount_application.title | upcase %}{% assign pairing_code = settings.bundle_offer_code | upcase %}{% if pairing_code != blank and allocation_code == pairing_code %}{{ settings.bundle_offer_code | escape }} · −{{ allocation.amount | money }}{% else %}{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }}){% endif %}</p>{% endif %}{% endfor %}<div class="cart-item__actions"><div class="cart-item__stepper" data-cart-stepper>
{% unless cart_page %}<button class="cart-item__stepper-btn" type="button" data-cart-quantity-step="-1" data-key="{{ item.key | escape }}" aria-label="Decrease {{ item.product.title | escape }} quantity">−</button>{% endunless %}
<label class="visually-hidden" for="CartQuantity-{{ scope }}-{{ item.index }}">{{ item.product.title | escape }} quantity</label><input id="CartQuantity-{{ scope }}-{{ item.index }}" type="number" min="0" step="1" value="{{ item.quantity }}" {% if cart_page %}name="updates[]"{% else %}data-cart-quantity data-key="{{ item.key | escape }}"{% endif %}>
{% unless cart_page %}<button class="cart-item__stepper-btn" type="button" data-cart-quantity-step="1" data-key="{{ item.key | escape }}" aria-label="Increase {{ item.product.title | escape }} quantity">+</button>{% endunless %}</div><a class="cart-item__remove-btn" href="{{ routes.cart_change_url }}?line={{ item.index | plus: 1 }}&amp;quantity=0" {% unless cart_page %}data-cart-remove data-key="{{ item.key | escape }}"{% endunless %} aria-label="Remove {{ item.product.title | escape }}">Remove</a></div></div></article>
