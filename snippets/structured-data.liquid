{%- comment -%}
  Structured Data Snippet: Product Schema.org JSON-LD
  Accepts:
  - product: {Object} Product Liquid object
{%- endcomment -%}

<script type="application/ld+json">
{
  "@context": "http://schema.org/",
  "@type": "Product",
  "name": {{ product.title | default: settings.product_name | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.featured_media -%}
    "image": [
      {{ product.featured_media | image_url: width: 1920 | prepend: "https:" | json }}
    ],
  {%- endif -%}
  "description": {{ product.description | strip_html | truncatewords: 50 | json }},
  {%- if product.selected_or_first_available_variant.sku != blank -%}
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": {{ settings.brand_name | default: shop.name | json }}
  },
  "offers": [
    {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "name": {{ variant.title | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "url": {{ shop.url | append: variant.url | json }},
        "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}"
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
