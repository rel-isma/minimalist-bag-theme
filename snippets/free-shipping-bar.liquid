{%- comment -%}
  Free Shipping Progress Bar Snippet
  Accepts:
  - cart: {Object} Cart object
{%- endcomment -%}

{%- liquid
  assign threshold_number = settings.free_shipping_threshold | default: 150
  if threshold_number > 0
    assign threshold_cents = threshold_number | times: 100
    assign cart_total = cart.total_price
    assign difference = threshold_cents | minus: cart_total

    if difference <= 0
      assign percent = 100
      assign unlocked = true
    else
      assign percent = cart_total | times: 100.0 | divided_by: threshold_cents | at_most: 100
      assign unlocked = false
    endif
  endif
-%}

{%- if threshold_number > 0 -%}
  <div class="free-shipping-bar" data-free-shipping-bar data-threshold="{{ threshold_cents }}">
    <div class="free-shipping-bar__message" data-free-shipping-message>
      {%- if unlocked -%}
        <span class="free-shipping-bar__text text-accent">
          ✓ {{ 'sections.cart.free_shipping_unlocked' | t }}
        </span>
      {%- else -%}
        {%- assign diff_money = difference | money -%}
        <span class="free-shipping-bar__text">
          {{ 'sections.cart.free_shipping_remaining_html' | t: amount: diff_money }}
        </span>
      {%- endif -%}
    </div>
    <div class="free-shipping-bar__progress-track" role="progressbar" aria-valuenow="{{ percent | round }}" aria-valuemin="0" aria-valuemax="100">
      <div class="free-shipping-bar__progress-fill" data-free-shipping-fill style="width: {{ percent }}%;"></div>
    </div>
  </div>
{%- endif -%}
