{%- comment -%}
  Product Media Gallery Snippet
  Accepts:
  - product: {Object} Product object
{%- endcomment -%}

<div class="product-gallery" data-product-gallery>
  <!-- Main Display / Slider -->
  <div class="product-gallery__main-wrap">
    <div class="product-gallery__main" data-gallery-main>
      {%- if product != blank and product.media.size > 0 -%}
        {%- for media in product.media -%}
          <div
            class="product-gallery__slide{% if forloop.first %} is-active{% endif %}"
            data-media-id="{{ media.id }}"
            data-index="{{ forloop.index0 }}"
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <div class="product-gallery__image-container" data-zoom-trigger data-zoom-src="{{ media | image_url: width: 2400 }}">
                  {{
                    media
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 900px) 50vw, 100vw',
                      widths: '400, 600, 800, 1000, 1400',
                      class: 'product-gallery__image',
                      alt: media.alt | default: product.title
                  }}
                  <button type="button" class="product-gallery__zoom-btn" aria-label="Zoom image">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                  </button>
                </div>
              {%- when 'video', 'external_video' -%}
                <div class="product-gallery__video-container">
                  {{ media | video_tag: controls: true, autoplay: false, loop: true, class: 'product-gallery__video' }}
                </div>
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Editorial Studio Gallery Slides (Default Atelier Bag Collection) -->
        <div class="product-gallery__slide is-active" data-index="0">
          <div class="product-gallery__image-container" data-zoom-trigger data-zoom-src="{{ 'packshot-front.jpg' | asset_url }}">
            <img src="{{ 'packshot-front.jpg' | asset_url }}" alt="The Demi Shoulder Bag in Bone" class="product-gallery__image" width="1400" height="1750" loading="eager">
            <button type="button" class="product-gallery__zoom-btn" aria-label="Zoom image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-gallery__slide" data-index="1">
          <div class="product-gallery__image-container" data-zoom-trigger data-zoom-src="{{ 'packshot-stone.jpg' | asset_url }}">
            <img src="{{ 'packshot-stone.jpg' | asset_url }}" alt="The Demi Shoulder Bag in Warm Stone" class="product-gallery__image" width="1400" height="1750" loading="lazy">
            <button type="button" class="product-gallery__zoom-btn" aria-label="Zoom image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-gallery__slide" data-index="2">
          <div class="product-gallery__image-container" data-zoom-trigger data-zoom-src="{{ 'packshot-noir.jpg' | asset_url }}">
            <img src="{{ 'packshot-noir.jpg' | asset_url }}" alt="The Demi Shoulder Bag in Noir" class="product-gallery__image" width="1400" height="1750" loading="lazy">
            <button type="button" class="product-gallery__zoom-btn" aria-label="Zoom image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-gallery__slide" data-index="3">
          <div class="product-gallery__image-container" data-zoom-trigger data-zoom-src="{{ 'packshot-clay.jpg' | asset_url }}">
            <img src="{{ 'packshot-clay.jpg' | asset_url }}" alt="The Demi Shoulder Bag in Clay" class="product-gallery__image" width="1400" height="1750" loading="lazy">
            <button type="button" class="product-gallery__zoom-btn" aria-label="Zoom image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-gallery__slide" data-index="4">
          <div class="product-gallery__image-container" data-zoom-trigger data-zoom-src="{{ 'detail-hardware.jpg' | asset_url }}">
            <img src="{{ 'detail-hardware.jpg' | asset_url }}" alt="Custom solid brass buckle macro" class="product-gallery__image" width="1400" height="1750" loading="lazy">
            <button type="button" class="product-gallery__zoom-btn" aria-label="Zoom image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-gallery__slide" data-index="5">
          <div class="product-gallery__image-container" data-zoom-trigger data-zoom-src="{{ 'detail-interior.jpg' | asset_url }}">
            <img src="{{ 'detail-interior.jpg' | asset_url }}" alt="Micro-suede lining and organization" class="product-gallery__image" width="1400" height="1750" loading="lazy">
            <button type="button" class="product-gallery__zoom-btn" aria-label="Zoom image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Mobile Dots Navigation -->
    <div class="product-gallery__dots" data-gallery-dots aria-hidden="true"></div>
  </div>

  <!-- Desktop Vertical Thumbnail Rail -->
  {%- if product != blank and product.media.size > 1 -%}
    <div class="product-gallery__thumbs" data-gallery-thumbs>
      {%- for media in product.media -%}
        <button
          type="button"
          class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
          data-thumb-index="{{ forloop.index0 }}"
          aria-label="View media {{ forloop.index }}"
        >
          {{ media | image_url: width: 160, height: 200, crop: 'center' | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
        </button>
      {%- endfor -%}
    </div>
  {%- elsif product == blank or product.media.size == 0 -%}
    <!-- Default Studio Gallery Thumbnails -->
    <div class="product-gallery__thumbs" data-gallery-thumbs>
      <button type="button" class="product-gallery__thumb is-active" data-thumb-index="0" aria-label="View Bone packshot">
        <img src="{{ 'packshot-front.jpg' | asset_url }}" alt="Bone packshot" width="160" height="200" loading="lazy">
      </button>
      <button type="button" class="product-gallery__thumb" data-thumb-index="1" aria-label="View Warm Stone packshot">
        <img src="{{ 'packshot-stone.jpg' | asset_url }}" alt="Warm Stone packshot" width="160" height="200" loading="lazy">
      </button>
      <button type="button" class="product-gallery__thumb" data-thumb-index="2" aria-label="View Noir packshot">
        <img src="{{ 'packshot-noir.jpg' | asset_url }}" alt="Noir packshot" width="160" height="200" loading="lazy">
      </button>
      <button type="button" class="product-gallery__thumb" data-thumb-index="3" aria-label="View Clay packshot">
        <img src="{{ 'packshot-clay.jpg' | asset_url }}" alt="Clay packshot" width="160" height="200" loading="lazy">
      </button>
      <button type="button" class="product-gallery__thumb" data-thumb-index="4" aria-label="View Hardware detail">
        <img src="{{ 'detail-hardware.jpg' | asset_url }}" alt="Hardware detail" width="160" height="200" loading="lazy">
      </button>
      <button type="button" class="product-gallery__thumb" data-thumb-index="5" aria-label="View Interior detail">
        <img src="{{ 'detail-interior.jpg' | asset_url }}" alt="Interior detail" width="160" height="200" loading="lazy">
      </button>
    </div>
  {%- endif -%}

  <!-- High-Resolution Image Zoom Modal -->
  <dialog class="zoom-modal" data-zoom-modal aria-label="Media Zoom">
    <div class="zoom-modal__content">
      <button type="button" class="zoom-modal__close" data-zoom-close aria-label="Close zoom preview">
        {%- render 'icon-close' -%}
      </button>
      <img
        src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
        alt="Enlarged product view"
        width="1200"
        height="1500"
        loading="lazy"
        class="zoom-modal__img"
        data-zoom-modal-img
      >
    </div>
  </dialog>
</div>
