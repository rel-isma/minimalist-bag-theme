<div class="product-gallery" data-product-gallery>
  <div class="product-gallery__main">
    {% for media in product.media %}<div class="product-gallery__slide{% if forloop.first %} is-active{% endif %}" data-product-media data-media-id="{{ media.id }}" data-image-id="{{ media.preview_image.id }}">
      {% case media.media_type %}{% when 'image' %}{% assign loading = 'lazy' %}{% if forloop.first %}{% assign loading = 'eager' %}{% endif %}<div class="product-gallery__image-container">{{ media | image_url: width: 1600 | image_tag: loading: loading, widths: '480, 750, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', class: 'product-gallery__image' }}<a class="btn btn--link product-zoom-link" href="{{ media | image_url: width: 1600 }}" data-product-zoom aria-label="Enlarge {{ media.alt | default: product.title | escape }}">Enlarge</a></div>{% when 'video' %}{{ media | video_tag: controls: true, autoplay: false }}{% when 'external_video' %}{{ media | external_video_tag }}{% else %}{{ media | media_tag }}{% endcase %}
    </div>{% else %}<div class="product-gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}<p class="text-muted">Product photography is being prepared.</p></div>{% endfor %}
  </div>
  {% if product.media.size > 1 %}<div class="product-gallery__thumbs">{% for media in product.media %}<a class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" href="{{ media.preview_image | image_url: width: 1200 }}" data-media-select="{{ media.id }}" aria-label="View {{ media.alt | default: product.title | escape }} — {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px' }}</a>{% endfor %}</div>{% endif %}
  <dialog class="catalog-dialog product-zoom-dialog" data-product-zoom-dialog aria-label="Enlarged product image"><button class="btn btn--link" type="button" data-product-zoom-close>Close</button><div data-product-zoom-content></div></dialog>
</div>
