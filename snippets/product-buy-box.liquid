{%- comment -%}
  Product Buy Box Snippet
  Accepts:
  - product: {Object} Product object
  - section_id: {String} Section ID
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section_id
-%}

<div class="product-buy-box" data-buy-box>
  <!-- Eyebrow & Title -->
  <div class="product-buy-box__header">
    <p class="eyebrow">{{ settings.brand_name | default: 'Minimalist Atelier' }}</p>
    <h1 class="product-buy-box__title">
      {{ product.title | default: settings.product_name | default: 'The Minimalist Shoulder Bag' }}
    </h1>
  </div>

  <!-- Price & Tax Line -->
  <div class="product-buy-box__price-line" data-price-container>
    {%- render 'price', product: product, use_variant: true, show_badges: true -%}
    {%- if cart.taxes_included -%}
      <span class="product-buy-box__tax-note text-muted">{{ 'products.product.taxes_included' | t }}</span>
    {%- endif -%}
  </div>

  <!-- Real Inventory Stock Warning (Zero Fake Urgency) -->
  {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 -%}
    <div class="inventory-status inventory-status--low text-accent">
      <span class="inventory-status__dot"></span>
      <span>{{ 'products.product.inventory.low_stock' | t: count: current_variant.inventory_quantity }}</span>
    </div>
  {%- endif -%}

  {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

    <!-- Color Variant Swatches -->
    {%- if product != blank and product.options_by_name['Color'] != blank -%}
      <div class="product-buy-box__option">
        <div class="product-buy-box__option-label">
          <span class="label-caps">Color:</span>
          <span class="product-buy-box__active-option-value" data-selected-color-label>
            {{ current_variant.options[0] | default: 'Bone' }}
          </span>
        </div>
        <div class="product-buy-box__swatches">
          {%- for value in product.options_by_name['Color'].values -%}
            {%- assign is_checked = false -%}
            {%- if value == current_variant.options[0] -%}
              {%- assign is_checked = true -%}
            {%- endif -%}
            {%- render 'swatch', value: value, name: 'Color', checked: is_checked, variant_id: current_variant.id -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <!-- Default single product swatches placeholder -->
      <div class="product-buy-box__option">
        <div class="product-buy-box__option-label">
          <span class="label-caps">Color:</span>
          <span class="product-buy-box__active-option-value">Bone</span>
        </div>
        <div class="product-buy-box__swatches">
          {%- render 'swatch', value: 'Bone', name: 'Color', checked: true -%}
          {%- render 'swatch', value: 'Warm Stone', name: 'Color', checked: false -%}
          {%- render 'swatch', value: 'Noir', name: 'Color', checked: false -%}
          {%- render 'swatch', value: 'Clay', name: 'Color', checked: false -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Quantity & Add to Cart -->
    <div class="product-buy-box__cta-group">
      <div class="product-buy-box__quantity-wrap">
        {%- assign quantity_input_id = 'Quantity-' | append: section_id -%}
        {%- render 'quantity-input', id: quantity_input_id, name: 'quantity', value: 1 -%}
      </div>

      <button
        type="submit"
        name="add"
        class="btn btn--primary btn--full product-buy-box__submit-btn"
        {% if current_variant.available == false %}disabled aria-disabled="true"{% endif %}
        data-add-to-cart-btn
      >
        <span>
          {%- if current_variant.available == false -%}
            {{ 'products.product.sold_out' | t }}
          {%- else -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- endif -%}
        </span>
      </button>
    </div>

    <!-- Accelerated Checkout (Shop Pay, Apple Pay, Google Pay) -->
    <div class="product-buy-box__dynamic-checkout">
      {{ form | payment_button }}
    </div>

    <!-- Installments banner -->
    {{ form | payment_terms }}
  {%- endform -%}

  <!-- Shipping & Returns Summary Strip -->
  <div class="product-buy-box__trust-line">
    <div class="product-buy-box__trust-item">
      {%- render 'icon-truck' -%}
      <span>2–4 business days delivery</span>
    </div>
    <div class="product-buy-box__trust-item">
      {%- render 'icon-return' -%}
      <span>30-day complimentary returns</span>
    </div>
  </div>
</div>
