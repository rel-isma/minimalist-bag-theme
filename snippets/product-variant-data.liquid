{% capture variant_data %}[{% for variant in product.variants %}{"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | json }},"comparePrice":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},"image":{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},"imageId":{{ variant.featured_image.id | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endcapture %}
<div hidden data-product-variants data-variants="{{ variant_data | escape }}"></div>
