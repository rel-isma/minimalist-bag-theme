# Real credentials and authentication state never belong in Git
.env
.env.*
!.env.example
**/*token*.json
**/*credentials*.json
**/cookies*.json
**/storage-state*.json
**/auth-state*.json

# Local tools, dependencies, builds and duplicate archives
/.aws/
/.codex/
/.agents/
/.shopify/
**/node_modules/
/dist/
/studio/dist/
/backups/
*.zip
*.tar.gz
.DS_Store
*.log
__pycache__/
*.pyc
