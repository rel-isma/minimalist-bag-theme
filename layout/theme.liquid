<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg | default: '#F5F1EA' }}">

    {%- render 'seo-tags' -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}



    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'catalog.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'store.css' | asset_url | stylesheet_tag }}
    {{ 'offers.css' | asset_url | stylesheet_tag }}
    {{ 'select.css' | asset_url | stylesheet_tag }}

    <style>
      {{ settings.heading_font | font_face: font_display: 'swap' }}
      {{ settings.body_font | font_face: font_display: 'swap' }}

      :root {
        --color-bg: {{ settings.color_bg | default: '#F5F1EA' }};
        --color-surface: {{ settings.color_surface | default: '#ECE5DA' }};
        --color-ink: {{ settings.color_ink | default: '#1B1A18' }};
        --color-muted: {{ settings.color_muted | default: '#6B6258' }};
        --color-accent: {{ settings.color_accent | default: '#9A4F36' }};
        --color-border: {{ settings.color_border | default: '#D9D0C3' }};
        --color-inverse-bg: {{ settings.color_inverse_bg | default: '#1B1A18' }};
        --color-inverse-text: {{ settings.color_inverse_text | default: '#F5F1EA' }};
        --font-heading: {{ settings.heading_font.family | default: '"Cormorant Garamond", "Playfair Display", Garamond, Georgia, serif' }}, {{ settings.heading_font.fallback_families | default: 'serif' }};
        --font-body: {{ settings.body_font.family | default: '"DM Sans", Jost, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif' }}, {{ settings.body_font.fallback_families | default: 'sans-serif' }};
        --container-max: {{ settings.page_width | default: 1320 }}px;
      }
    </style>

    {{ content_for_header }}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'reviews.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'catalog.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'offers.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'select.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-to-content" href="#MainContent">
      {{ 'general.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% render 'store-offers' %}
    <div hidden data-catalog-config data-cart-url="{{ routes.cart_url }}" data-cart-type="{{ settings.cart_type | default: 'drawer' }}"></div>
    <dialog class="catalog-dialog" data-quick-view-dialog aria-label="Choose product options">
      <div class="catalog-dialog__header"><span class="eyebrow">{{ settings.brand_name | escape }}</span><button type="button" class="btn btn--link" data-dialog-close aria-label="Close quick view">Close</button></div>
      <div data-quick-view-content role="status" aria-live="polite"></div>
    </dialog>
  </body>
</html>
