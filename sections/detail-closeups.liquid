<section class="detail-closeups-section section-spacing hairline-bottom">
  <div class="container">
    <div class="section-header text-center fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subhead != blank -%}
        <p class="text-muted prose" style="margin: 0 auto;">{{ section.settings.subhead | escape }}</p>
      {%- endif -%}
    </div>

    <div class="detail-closeups__grid">
      <!-- 1. Hardware Close-Up -->
      <div class="detail-closeups__card fade-up">
        <div class="detail-closeups__media">
          {%- if section.settings.image_1 != blank -%}
            {{
              section.settings.image_1
              | image_url: width: 800
              | image_tag: loading: 'lazy', class: 'detail-closeups__image', alt: section.settings.title_1
            }}
          {%- else -%}
            <img
              src="{{ 'detail-hardware.jpg' | asset_url }}"
              alt="{{ section.settings.title_1 | escape }}"
              class="detail-closeups__image"
              width="800"
              height="800"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="detail-closeups__content">
          <h3 class="detail-closeups__title">{{ section.settings.title_1 | escape }}</h3>
          <p class="text-muted" style="font-size: 0.9375rem;">{{ section.settings.text_1 | escape }}</p>
        </div>
      </div>

      <!-- 2. Stitching Close-Up -->
      <div class="detail-closeups__card fade-up">
        <div class="detail-closeups__media">
          {%- if section.settings.image_2 != blank -%}
            {{
              section.settings.image_2
              | image_url: width: 800
              | image_tag: loading: 'lazy', class: 'detail-closeups__image', alt: section.settings.title_2
            }}
          {%- else -%}
            <img
              src="{{ 'craft-stitching.jpg' | asset_url }}"
              alt="{{ section.settings.title_2 | escape }}"
              class="detail-closeups__image"
              width="800"
              height="800"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="detail-closeups__content">
          <h3 class="detail-closeups__title">{{ section.settings.title_2 | escape }}</h3>
          <p class="text-muted" style="font-size: 0.9375rem;">{{ section.settings.text_2 | escape }}</p>
        </div>
      </div>

      <!-- 3. Interior Close-Up -->
      <div class="detail-closeups__card fade-up">
        <div class="detail-closeups__media">
          {%- if section.settings.image_3 != blank -%}
            {{
              section.settings.image_3
              | image_url: width: 800
              | image_tag: loading: 'lazy', class: 'detail-closeups__image', alt: section.settings.title_3
            }}
          {%- else -%}
            <img
              src="{{ 'detail-interior.jpg' | asset_url }}"
              alt="{{ section.settings.title_3 | escape }}"
              class="detail-closeups__image"
              width="800"
              height="800"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="detail-closeups__content">
          <h3 class="detail-closeups__title">{{ section.settings.title_3 | escape }}</h3>
          <p class="text-muted" style="font-size: 0.9375rem;">{{ section.settings.text_3 | escape }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Detail close-ups",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Up Close"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Integrity of Every Seam"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheading",
      "default": "Every mm inspected by hand before leaving our studio workshop."
    },
    {
      "type": "header",
      "content": "Detail 1: Hardware"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Hardware image"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Hardware title",
      "default": "Custom Solid Brass Clasp"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Hardware description",
      "default": "Brushed satin finish that resists scratches and snaps into place with a reassuring muted click."
    },
    {
      "type": "header",
      "content": "Detail 2: Stitching"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Stitching image"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Stitching title",
      "default": "Hand-Painted Edge Dye"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Stitching description",
      "default": "Raw leather edges receive four successive coats of matte edge paint, sanded smooth between each application."
    },
    {
      "type": "header",
      "content": "Detail 3: Interior"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Interior image"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Interior title",
      "default": "Suede-Lined Sanctuary"
    },
    {
      "type": "textarea",
      "id": "text_3",
      "label": "Interior description",
      "default": "Soft microfiber suede interior protects screens and sunglasses, with dedicated pockets for cards and lip balm."
    }
  ],
  "presets": [
    {
      "name": "Detail close-ups"
    }
  ]
}
{% endschema %}
