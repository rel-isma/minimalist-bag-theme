<section class="section-spacing hairline-bottom" data-cart-page><div class="container container--narrow"><header class="section-header"><h1 class="section-heading">{{ section.settings.heading | escape }}</h1></header>{% render 'free-shipping-bar', cart: cart %}{% if cart.empty? %}<div class="collection-empty"><h2 class="font-heading">{{ section.settings.empty_heading | escape }}</h2><p class="text-muted">{{ section.settings.empty_text | escape }}</p><a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" id="MainCartForm-{{ section.id }}"><div>{% for item in cart.items %}{% render 'cart-item', item: item, cart_page: true, scope: section.id %}{% endfor %}</div><div class="main-cart__footer-grid"><div>{% if settings.enable_cart_notes %}<label class="form-label" for="MainCartNote-{{ section.id }}">Order note</label><textarea id="MainCartNote-{{ section.id }}" name="note" class="form-input" rows="3">{{ cart.note | escape }}</textarea>{% endif %}</div><div><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p class="text-muted">{{ section.settings.shipping_note | escape }}</p><button class="btn btn--secondary" type="submit" name="update">Update bag</button><button class="btn btn--primary" type="submit" name="checkout">Checkout</button></div></div></form>{% endif %}</div></section>
{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your bag"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty bag heading",
      "default": "Your bag is empty"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty bag text",
      "default": "Explore bags and everyday essentials."
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping note",
      "default": "Taxes and shipping are calculated at checkout."
    }
  ],
  "enabled_on": {
    "templates": [
      "cart"
    ]
  },
  "limit": 1
}
{% endschema %}
