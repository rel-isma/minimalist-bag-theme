<section class="section-spacing hairline-bottom" data-cart-page><div class="container container--narrow"><header class="section-header"><h1 class="section-heading">Your bag</h1></header>{% render 'free-shipping-bar', cart: cart %}{% if cart.empty? %}<div class="collection-empty"><h2 class="font-heading">Your bag is empty</h2><p class="text-muted">Explore bags and everyday essentials.</p><a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" id="MainCartForm"><div>{% for item in cart.items %}{% render 'cart-item', item: item, cart_page: true, scope: section.id %}{% endfor %}</div><div class="main-cart__footer-grid"><div>{% if settings.enable_cart_notes %}<label class="form-label" for="MainCartNote">Order note</label><textarea id="MainCartNote" name="note" class="form-input" rows="3">{{ cart.note | escape }}</textarea>{% endif %}</div><div><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p class="text-muted">Taxes and shipping are calculated at checkout.</p><button class="btn btn--secondary" type="submit" name="update">Update bag</button><button class="btn btn--primary" type="submit" name="checkout">Checkout</button></div></div></form>{% endif %}</div></section>
{% schema %}
{"name":"Cart","settings":[]}
{% endschema %}
