<section class="main-cart-section section-spacing hairline-bottom">
  <div class="container container--narrow">
    <div class="section-header text-center fade-up">
      <h1 class="section-heading">{{ 'sections.cart.title' | t }}</h1>
    </div>

    <!-- Free Shipping Progress -->
    <div class="main-cart__shipping-banner fade-up" style="margin-bottom: 2.5rem;">
      {%- render 'free-shipping-bar', cart: cart -%}
    </div>

    {%- if cart.empty? -%}
      <div class="main-cart__empty text-center fade-up" style="padding: 4rem 1rem;">
        <p class="font-heading" style="font-size: 1.75rem; margin-bottom: 0.75rem;">
          {{ 'sections.cart.empty' | t }}
        </p>
        <p class="text-muted prose" style="margin: 0 auto 2rem auto;">
          Your bag is currently empty. Explore our collection of quiet luxury essentials.
        </p>
        <a href="{{ routes.root_url }}#ProductSpotlight" class="btn btn--primary">
          {{ 'sections.cart.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="MainCartForm" class="main-cart__form fade-up">
        <div class="main-cart__items-list">
          {%- for item in cart.items -%}
            {%- render 'cart-item', item: item -%}
          {%- endfor -%}
        </div>

        <div class="main-cart__footer" style="margin-top: 3rem; padding-top: 2rem; border-top: var(--border-hairline);">
          <div class="main-cart__footer-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start;">
            <!-- Notes -->
            <div class="main-cart__notes-col">
              {%- if settings.enable_cart_notes -%}
                <label for="MainCart-Note" class="label-caps" style="display: block; margin-bottom: 0.5rem;">
                  {{ 'sections.cart.note' | t }}
                </label>
                <textarea
                  id="MainCart-Note"
                  name="note"
                  class="form-input"
                  rows="3"
                  placeholder="Special instructions or gift note..."
                >{{ cart.note }}</textarea>
              {%- endif -%}
            </div>

            <!-- Subtotal & Checkout -->
            <div class="main-cart__checkout-col text-right" style="text-align: right;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
                <span class="label-caps">{{ 'sections.cart.subtotal' | t }}</span>
                <span class="font-medium" style="font-size: 1.5rem; color: var(--color-ink);">
                  {{ cart.total_price | money }}
                </span>
              </div>
              <p class="text-muted" style="font-size: 0.8125rem; margin-bottom: 1.5rem;">
                {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
              </p>
              <button type="submit" name="checkout" class="btn btn--primary btn--full">
                {{ 'sections.cart.checkout' | t }}
              </button>
            </div>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
