<section id="ColorStory" class="color-story-section section-spacing hairline-bottom">
  <div class="container">
    <div class="section-header text-center fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subhead != blank -%}
        <p class="text-muted prose" style="margin: 0 auto;">{{ section.settings.subhead | escape }}</p>
      {%- endif -%}
    </div>

    <div class="color-story__grid">
      {%- for block in section.blocks -%}
        <div class="color-story__card fade-up" {{ block.shopify_attributes }}>
          <div class="color-story__media" style="background-color: {{ block.settings.swatch_hex }};">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag: loading: 'lazy', class: 'color-story__image', alt: block.settings.color_name
              }}
            {%- else -%}
              <div class="color-story__swatch-circle" style="background-color: {{ block.settings.swatch_hex }};"></div>
            {%- endif -%}
          </div>
          <div class="color-story__info">
            <h3 class="color-story__name">{{ block.settings.color_name | escape }}</h3>
            <p class="color-story__desc text-muted">{{ block.settings.description | escape }}</p>
            <a href="#ProductSpotlight" class="btn btn--link" style="margin-top: 0.5rem;">
              Select {{ block.settings.color_name | escape }}
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Color story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Tonal Palette"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four Nuanced Shades"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheading",
      "default": "Formulated with low-impact aniline dyes that reveal the natural hide's subtle depth."
    }
  ],
  "blocks": [
    {
      "type": "colorway",
      "name": "Colorway",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "color_name",
          "label": "Color name",
          "default": "Bone"
        },
        {
          "type": "color",
          "id": "swatch_hex",
          "label": "Swatch color",
          "default": "#F5F1EA"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Colorway photo"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Color description",
          "default": "An unbleached limestone hue. Warm, neutral, and effortlessly adaptable to linen and wool alike."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Color story",
      "blocks": [
        {
          "type": "colorway",
          "settings": {
            "color_name": "Bone",
            "swatch_hex": "#F5F1EA",
            "description": "An unbleached limestone hue. Warm, neutral, and effortlessly adaptable to linen and wool alike."
          }
        },
        {
          "type": "colorway",
          "settings": {
            "color_name": "Warm Stone",
            "swatch_hex": "#ECE5DA",
            "description": "A grounded taupe-sand tone with gentle warmth. Subtle, understated, and timeless."
          }
        },
        {
          "type": "colorway",
          "settings": {
            "color_name": "Noir",
            "swatch_hex": "#1B1A18",
            "description": "Deep charcoal ink black. Deeply saturated with a soft satin finish that avoids harsh synthetic shine."
          }
        },
        {
          "type": "colorway",
          "settings": {
            "color_name": "Clay",
            "swatch_hex": "#9A4F36",
            "description": "Tuscan terracotta earth. Adds an intentional, sophisticated pop of warm color to monochromatic looks."
          }
        }
      ]
    }
  ]
}
{% endschema %}
