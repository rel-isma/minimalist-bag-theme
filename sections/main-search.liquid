<section class="main-search-section section-spacing hairline-bottom">
  <div class="container container--narrow">
    <header class="section-header text-center fade-up">
      <h1 class="section-heading">{{ 'general.search' | t }}</h1>
    </header>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form fade-up" style="max-width: 500px; margin: 0 auto 3rem auto; display: flex; gap: 0.5rem;">
      <label for="Search-Input" class="visually-hidden">{{ 'general.search' | t }}</label>
      <input
        type="search"
        id="Search-Input"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search our atelier..."
        class="form-input"
      >
      <button type="submit" class="btn btn--primary" style="min-width: 100px;">
        Search
      </button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="text-center fade-up" style="padding: 2rem 0;">
          <p class="text-muted" style="margin-bottom: 2rem;">No results found for &ldquo;{{ search.terms }}&rdquo;.</p>
          <a href="{{ routes.root_url }}#ProductSpotlight" class="btn btn--secondary">Discover The Shoulder Bag</a>
        </div>
      {%- else -%}
        <div class="search-results-list fade-up">
          {%- for item in search.results -%}
            <div style="padding: 1.5rem 0; border-bottom: var(--border-hairline);">
              <h2 class="font-heading" style="font-size: 1.25rem; margin-bottom: 0.5rem;">
                <a href="{{ item.url }}">{{ item.title | escape }}</a>
              </h2>
              <p class="text-muted" style="font-size: 0.875rem;">
                {{ item.content | strip_html | truncatewords: 30 }}
              </p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
