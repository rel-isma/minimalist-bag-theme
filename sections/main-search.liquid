<section class="main-search-section section-spacing hairline-bottom" data-search-page>
  <div class="container">
    <header class="section-header text-center"><h1 class="section-heading">Search the atelier</h1></header>
    <div class="search-page-form">{%- assign search_input_id = 'SearchInput-' | append: section.id -%}{% render 'search-form', input_id: search_input_id, predictive: section.settings.enable_predictive_search %}</div>
    {%- if search.performed -%}
      <p class="search-page-count" role="status">{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %} for “{{ search.terms | escape }}”</p>
      {%- paginate search.results by section.settings.results_per_page -%}
        <div class="search-page-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- assign eager = false -%}{%- if forloop.index <= 2 -%}{%- assign eager = true -%}{%- endif -%}
              {% render 'product-card', product: item, section_id: section.id, card_index: forloop.index, eager: eager %}
            {%- else -%}
              <article class="search-page-card"><p class="eyebrow">Page</p><h2 class="font-heading"><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p class="text-muted">{{ item.content | strip_html | truncatewords: 30 | escape }}</p><a class="btn btn--link" href="{{ item.url }}">Read more<span class="visually-hidden"> — {{ item.title | escape }}</span></a></article>
            {%- endif -%}
          {%- else -%}
            <div class="collection-empty"><h2 class="font-heading">No results found</h2><p class="text-muted">Try a product name, color, or a simpler search.</p><a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">Browse all products</a></div>
          {%- endfor -%}
        </div>
        {% if paginate.pages > 1 %}<nav class="collection-pagination" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}{% assign current_page_string = paginate.current_page | append: '' %}{% for part in paginate.parts %}{% assign part_title_string = part.title | append: '' %}{% if part.is_link %}<a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>{% elsif part_title_string == current_page_string %}<span aria-current="page" aria-label="Page {{ part.title }}">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}{% endfor %}{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}
      {%- endpaginate -%}
    {%- else -%}<p class="text-center text-muted">Explore products and stories from our atelier.</p>{%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Search","settings":[{"type":"checkbox","id":"enable_predictive_search","label":"Enable predictive search","default":true},{"type":"range","id":"results_per_page","label":"Results per page","min":4,"max":48,"step":4,"default":12}]}
{% endschema %}
