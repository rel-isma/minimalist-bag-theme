<section id="BrandStory" class="brand-story-section section-spacing hairline-bottom">
  <div class="container">
    <div class="brand-story__grid">
      <div class="brand-story__media fade-up">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '480, 750, 1200', sizes: '(min-width: 990px) 50vw, 100vw', class: 'brand-story__image', alt: section.settings.heading
          }}
        {%- else -%}
          <img
            src="{{ 'demo-story-750.webp' | asset_url }}"
            srcset="{{ 'demo-story-480.webp' | asset_url }} 480w, {{ 'demo-story-750.webp' | asset_url }} 750w, {{ 'demo-story-1200.webp' | asset_url }} 1200w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ section.settings.heading | escape }}"
            class="brand-story__image"
            width="1200"
            height="900"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="brand-story__content fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="brand-story__heading">{{ section.settings.heading | escape }}</h2>
        <div class="brand-story__body prose text-muted">
          {{ section.settings.story_text }}
        </div>

        {%- if section.settings.signoff_name != blank -%}
          <div class="brand-story__signoff">
            <p class="font-heading" style="font-size: 1.5rem; color: var(--color-ink); margin-bottom: 0.25rem;">
              {{ section.settings.signoff_name | escape }}
            </p>
            <p class="label-caps text-muted">{{ section.settings.signoff_title | escape }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fewer, better things."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story copy",
      "default": "<p>Our starting point is simple: considered proportions, calm colors, and room for everyday essentials. Atelier Vane explores bags and small accessories that sit naturally within a thoughtful wardrobe.</p><p>This development collection is a design study. Real materials, construction and specifications will be shared when each piece is ready.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atelier photo"
    },
    {
      "type": "text",
      "id": "signoff_name",
      "label": "Sign-off name",
      "default": "Atelier Vane Studio"
    },
    {
      "type": "text",
      "id": "signoff_title",
      "label": "Sign-off title",
      "default": "Design and proportion"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
