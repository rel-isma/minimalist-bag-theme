<section id="BrandStory" class="brand-story-section section-spacing hairline-bottom">
  <div class="container">
    <div class="brand-story__grid">
      <div class="brand-story__media fade-up">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', class: 'brand-story__image', alt: section.settings.heading
          }}
        {%- else -%}
          <div class="brand-story__placeholder">
            <span class="label-caps">Atelier Studio Photo</span>
          </div>
        {%- endif -%}
      </div>

      <div class="brand-story__content fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="brand-story__heading">{{ section.settings.heading | escape }}</h2>
        <div class="brand-story__body prose text-muted">
          {{ section.settings.story_text }}
        </div>

        {%- if section.settings.signoff_name != blank -%}
          <div class="brand-story__signoff">
            <p class="font-heading" style="font-size: 1.5rem; color: var(--color-ink); margin-bottom: 0.25rem;">
              {{ section.settings.signoff_name | escape }}
            </p>
            <p class="label-caps text-muted">{{ section.settings.signoff_title | escape }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fewer, Better Things."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story copy",
      "default": "<p>We founded our studio on a single conviction: modern wardrobes do not need dozens of seasonal bags that quickly date and discard. They need one archetype, resolved so thoroughly in its proportion, feel, and durability that you reach for it without hesitation every morning.</p><p>We bypassed traditional wholesale markups and retail licensing to invest directly where it matters—in full-grain hides, hand-painted edge dyes, and solid brass components meant to outlast trends.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atelier photo"
    },
    {
      "type": "text",
      "id": "signoff_name",
      "label": "Sign-off name",
      "default": "Atelier Studio"
    },
    {
      "type": "text",
      "id": "signoff_title",
      "label": "Sign-off title",
      "default": "Design & Craftsmanship"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
