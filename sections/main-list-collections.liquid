<section class="section-spacing hairline-bottom"><div class="container"><header class="section-header"><h1 class="section-heading">{{ section.settings.heading | escape }}</h1></header>{% paginate collections by section.settings.collections_per_page %}<div class="category-grid">{% for collection in collections %}<a class="category-tile" href="{{ collection.url }}">{% if collection.image %}{{ collection.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 900', sizes: '(min-width: 990px) 33vw, 50vw' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}<h2 class="font-heading">{{ collection.title | escape }}</h2><p class="text-muted">{{ collection.all_products_count }} products</p></a>{% else %}<p>Our collections are being prepared.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="collection-pagination" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}<span aria-current="page">{{ paginate.current_page }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}{% endpaginate %}</div></section>
{% schema %}
{"name":"Collections list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Collections"},{"type":"range","id":"collections_per_page","label":"Collections per page","min":4,"max":24,"step":4,"default":12}]}
{% endschema %}
