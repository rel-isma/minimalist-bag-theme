{%- comment -%}
  Reviews Section: Strictly displays real reviews.
  If zero reviews are configured by the merchant, this section completely hides.
  Never display fake reviews, fake ratings, or unverified claims.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section id="Reviews" class="reviews-section section-spacing hairline-bottom">
    <div class="container">
      <div class="section-header text-center fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subhead != blank -%}
          <p class="text-muted prose" style="margin: 0 auto;">{{ section.settings.subhead | escape }}</p>
        {%- endif -%}
      </div>

      <div class="reviews__grid">
        {%- for block in section.blocks -%}
          <div class="review-card fade-up" {{ block.shopify_attributes }}>
            <!-- Star Rating Display -->
            <div class="review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="review-star{% if i <= block.settings.rating %} is-active{% endif %}" aria-hidden="true">★</span>
              {%- endfor -%}
            </div>

            <blockquote class="review-card__quote">
              &ldquo;{{ block.settings.review_text | escape }}&rdquo;
            </blockquote>

            <div class="review-card__author">
              <span class="review-card__name font-medium">{{ block.settings.reviewer_name | escape }}</span>
              {%- if block.settings.verified_buyer -%}
                <span class="review-card__badge label-caps text-muted">Verified Buyer</span>
              {%- endif -%}
              {%- if block.settings.date != blank -%}
                <span class="review-card__date text-muted">{{ block.settings.date | escape }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Client Reflections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In Everyday Use"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheading",
      "default": "Unsolicited feedback from patrons who carry our archetype daily."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Verified review",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Client name",
          "default": "Client Review"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "Add authentic verified review content here."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Review date"
        },
        {
          "type": "checkbox",
          "id": "verified_buyer",
          "label": "Verified buyer badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": []
    }
  ]
}
{% endschema %}
