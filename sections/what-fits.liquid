<section id="WhatFits" class="what-fits-section section-spacing hairline-bottom">
  <div class="container">
    <div class="section-header text-center fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subhead != blank -%}
        <p class="text-muted prose" style="margin: 0 auto;">{{ section.settings.subhead | escape }}</p>
      {%- endif -%}
    </div>

    <div class="what-fits__grid">
      <!-- Media with Annotated Markers -->
      <div class="what-fits__media-col fade-up">
        <div class="what-fits__media-wrap">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'what-fits__image',
                alt: section.settings.heading
            }}
          {%- else -%}
            <img
              src="{{ 'detail-interior.jpg' | asset_url }}"
              alt="{{ section.settings.heading | escape }}"
              class="what-fits__image"
              width="1200"
              height="900"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        <!-- Packing List Tag Pills -->
        <div class="what-fits__items-list">
          <span class="what-fits__pill">✓ iPhone 15 Pro Max</span>
          <span class="what-fits__pill">✓ Bifold Cardholder</span>
          <span class="what-fits__pill">✓ Car Keys & Fob</span>
          <span class="what-fits__pill">✓ Sunglasses in Soft Pouch</span>
          <span class="what-fits__pill">✓ Lip Balm & Compact</span>
          <span class="what-fits__pill">✓ Passport</span>
        </div>
      </div>

      <!-- Dimensions and Specification Table -->
      <div class="what-fits__table-col fade-up">
        <div class="dimensions-card">
          <h3 class="dimensions-card__title">{{ section.settings.table_title | escape }}</h3>
          <p class="text-muted" style="font-size: 0.9375rem; margin-bottom: 2rem;">
            {{ section.settings.table_note | escape }}
          </p>

          <table class="dimensions-table">
            <tbody>
              <tr>
                <th scope="row">Width</th>
                <td>26 cm <span class="text-muted">(10.2 inches)</span></td>
              </tr>
              <tr>
                <th scope="row">Height</th>
                <td>15 cm <span class="text-muted">(5.9 inches)</span></td>
              </tr>
              <tr>
                <th scope="row">Depth</th>
                <td>7 cm <span class="text-muted">(2.8 inches)</span></td>
              </tr>
              <tr>
                <th scope="row">Strap Drop</th>
                <td>28 cm <span class="text-muted">(11.0 inches)</span></td>
              </tr>
              <tr>
                <th scope="row">Weight (Unfilled)</th>
                <td>380 grams <span class="text-muted">(0.83 lbs)</span></td>
              </tr>
              <tr>
                <th scope="row">Closure</th>
                <td>Concealed magnetic snap</td>
              </tr>
              <tr>
                <th scope="row">Interior Configuration</th>
                <td>1 main compartment, 1 zipped slip pocket</td>
              </tr>
            </tbody>
          </table>

          <div style="margin-top: 2rem;">
            <a href="#ProductSpotlight" class="btn btn--primary btn--full">
              Select Your Colorway
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "What fits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Capacity & Scale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything You Need. Nothing You Don't."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheading",
      "default": "Engineered to hold daily essentials without bulging or compromising its clean architectural drape."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "What fits flat lay image"
    },
    {
      "type": "text",
      "id": "table_title",
      "label": "Table title",
      "default": "Exact Specifications"
    },
    {
      "type": "text",
      "id": "table_note",
      "label": "Table note",
      "default": "Proportioned specifically to sit naturally tucked at the ribcage."
    }
  ],
  "presets": [
    {
      "name": "What fits"
    }
  ]
}
{% endschema %}
