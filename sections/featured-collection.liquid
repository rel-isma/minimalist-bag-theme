{% assign featured = section.settings.collection %}<section class="section-spacing hairline-bottom"><div class="container"><header class="section-header collection-row-header"><h2 class="section-heading">{{ section.settings.heading | escape }}</h2>{% if featured != blank %}<a class="btn btn--link" href="{{ featured.url }}">View all</a>{% endif %}</header><div class="collection-product-grid" style="--collection-columns: {{ settings.collection_grid_columns | default: '3' }};">{% for product in featured.products limit: section.settings.limit %}{% render 'product-card', product: product, section_id: section.id, card_index: forloop.index %}{% else %}<div class="collection-empty"><p class="text-muted">This collection is being prepared.</p>{% if request.design_mode %}<p>Select a collection containing products.</p>{% endif %}<a class="btn btn--link" href="{{ routes.all_products_collection_url }}">Browse all products</a></div>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A considered edit"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ],
  "enabled_on": {
    "templates": [
      "*"
    ]
  }
}
{% endschema %}
