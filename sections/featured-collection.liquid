{% assign featured = section.settings.collection %}{% assign featured_columns = settings.collection_grid_columns | default: '3' %}{% if section.settings.columns != blank and section.settings.columns != 'global' %}{% assign featured_columns = section.settings.columns %}{% endif %}<section class="section-spacing hairline-bottom"><div class="container"><header class="section-header collection-row-header"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 class="section-heading">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<p class="text-muted">{{ section.settings.text | escape }}</p>{% endif %}</div>{% if featured != blank %}<a class="btn btn--link" href="{{ featured.url }}">View all</a>{% endif %}</header><div class="collection-product-grid" style="--collection-columns: {{ featured_columns }};">{% for product in featured.products limit: section.settings.limit %}{% render 'product-card', product: product, section_id: section.id, card_index: forloop.index %}{% else %}<div class="collection-empty"><p class="text-muted">This collection is being prepared.</p>{% if request.design_mode %}<p>Select a collection containing products.</p>{% endif %}<a class="btn btn--link" href="{{ routes.all_products_collection_url }}">Browse all products</a></div>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {"type":"select","id":"columns","label":"Desktop columns","options":[{"value":"global","label":"Use theme setting"},{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"global"},
    {"type":"text","id":"eyebrow","label":"Eyebrow"},
    {"type":"text","id":"text","label":"Description"},
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A considered edit"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ],
  "enabled_on": {
    "templates": [
      "*"
    ]
  }
}
{% endschema %}
