<section class="section-spacing hairline-bottom"><div class="container"><header class="section-header"><h2 class="section-heading">{{ section.settings.heading | escape }}</h2></header><div class="shop-look"><div class="shop-look__image">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 900, 1600', sizes: '100vw' }}{% else %}<img src="{{ 'demo-look-900.webp' | asset_url }}" srcset="{{ 'demo-look-480.webp' | asset_url }} 480w, {{ 'demo-look-900.webp' | asset_url }} 900w, {{ 'demo-look-1600.webp' | asset_url }} 1600w" sizes="100vw" alt="AI-generated demo work scene; replace with real photography" loading="lazy" width="1600" height="1067">{% endif %}
{% for block in section.blocks %}{% if block.settings.product != blank %}<a class="shop-look__pin" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;" href="{{ block.settings.product.url }}" aria-label="{{ forloop.index }} — Shop {{ block.settings.product.title | escape }}" {{ block.shopify_attributes }}>{{ forloop.index }}</a>{% endif %}{% endfor %}</div><div class="shop-look__products">{% for block in section.blocks %}{% if block.settings.product != blank %}<p><span class="eyebrow">{{ forloop.index }}</span> <a class="btn btn--link" href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a></p>{% endif %}{% endfor %}</div></div></div></section>
{% schema %}
{
  "name": "Shop the look",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In good company"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Scene image"
    }
  ],
  "blocks": [
    {
      "type": "pin",
      "name": "Product pin",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Shop the look"
    }
  ],
  "enabled_on": {
    "templates": [
      "*"
    ]
  }
}
{% endschema %}
