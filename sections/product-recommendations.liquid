{% if product != blank %}<section data-product-recommendations data-url="{{ routes.product_recommendations_url }}" data-product-id="{{ product.id }}" data-section-id="{{ section.id }}" data-intent="{{ section.settings.intent }}" data-limit="{{ section.settings.limit }}" {% unless recommendations.products_count > 0 %}hidden{% endunless %}>
<div data-recommendation-content>{% if recommendations.products_count > 0 %}<div class="section-spacing hairline-bottom"><div class="container"><h2 class="section-heading">{{ section.settings.heading | escape }}</h2><div class="collection-product-grid" style="--collection-columns: 4;">{% for product in recommendations.products %}{% render 'product-card', product: product, section_id: section.id, card_index: forloop.index %}{% endfor %}</div></div></div>{% endif %}</div></section>{% endif %}
{% schema %}
{"name":"Product recommendations","settings":[{"type":"text","id":"heading","label":"Heading","default":"You may also like"},{"type":"select","id":"intent","label":"Recommendation type","options":[{"value":"related","label":"Related products"},{"value":"complementary","label":"Complementary products"}],"default":"related"},{"type":"range","id":"limit","label":"Products to show","min":2,"max":8,"step":1,"default":4}]}
{% endschema %}
