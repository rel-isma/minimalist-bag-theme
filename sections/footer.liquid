<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <!-- Col 1: Brand & Atelier -->
      <div class="site-footer__col">
        <h3 class="site-footer__brand-title">
          {{ settings.brand_name | default: shop.name }}
        </h3>
        <p class="text-muted prose" style="font-size: 0.9375rem; line-height: 1.6;">
          {{ section.settings.brand_bio | escape }}
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="site-footer__col">
        <h4 class="site-footer__col-title">Explore</h4>
        <ul class="site-footer__links">
          <li><a href="#ProductSpotlight" class="site-footer__link">The Shoulder Bag</a></li>
          <li><a href="#WhyThisBag" class="site-footer__link">Craftsmanship</a></li>
          <li><a href="#WhatFits" class="site-footer__link">Dimensions & Capacity</a></li>
          <li><a href="#ColorStory" class="site-footer__link">Color Palette</a></li>
          <li><a href="#Reviews" class="site-footer__link">Client Reflections</a></li>
        </ul>
      </div>

      <!-- Col 3: Assistance & Policies -->
      <div class="site-footer__col">
        <h4 class="site-footer__col-title">Client Care</h4>
        <ul class="site-footer__links">
          <li><a href="#Faq" class="site-footer__link">Frequently Asked Questions</a></li>
          <li><a href="{{ routes.root_url }}pages/shipping-returns" class="site-footer__link">Shipping & Returns</a></li>
          <li><a href="{{ routes.root_url }}pages/contact" class="site-footer__link">Contact Atelier</a></li>
          <li><a href="{{ shop.privacy_policy.url | default: '/pages/privacy' }}" class="site-footer__link">Privacy Policy</a></li>
          <li><a href="{{ shop.terms_of_service.url | default: '/pages/terms' }}" class="site-footer__link">Terms of Service</a></li>
          <li><a href="{{ shop.refund_policy.url | default: '/pages/refund' }}" class="site-footer__link">Refund Policy</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter or Inquiries -->
      <div class="site-footer__col">
        <h4 class="site-footer__col-title">Correspondence</h4>
        <p class="text-muted" style="font-size: 0.875rem; margin-bottom: 1rem;">
          {{ section.settings.newsletter_subtext | escape }}
        </p>
        {%- form 'customer', id: 'FooterNewsletterForm', class: 'footer-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display: flex; gap: 0.5rem;">
            <label for="FooterEmail" class="visually-hidden">Email address</label>
            <input
              id="FooterEmail"
              type="email"
              name="contact[email]"
              class="form-input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="Your email address"
              required
            >
            <button type="submit" class="btn btn--primary" style="min-width: 90px; padding: 0.75rem 1.25rem;">
              Join
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="text-accent" style="font-size: 0.8125rem; margin-top: 0.5rem;" tabindex="-1" autofocus>
              Thank you for subscribing.
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <!-- Bottom Strip -->
    <div class="site-footer__bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }}. {{ 'sections.footer.copyright' | t }}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
        <div class="site-footer__payment-icons" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand bio",
      "default": "Designed in pursuit of quiet luxury and intentional form. One archetype, refined until nothing remains to subtract."
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter note",
      "default": "Occasional atelier notes and limited batch notifications. Never spam."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}
