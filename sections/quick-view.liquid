{%- if product != blank -%}
  {%- assign selected_variant = product.selected_or_first_available_variant -%}
  <div class="quick-view" data-quick-view-product>
    <div class="quick-view__media">
      {%- if selected_variant.featured_image != blank -%}
        {{ selected_variant.featured_image | image_url: width: 720 | image_tag: loading: 'eager', widths: '360, 540, 720', sizes: '(min-width: 750px) 40vw, 90vw', data-quick-view-image: '' }}
      {%- elsif product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 720 | image_tag: loading: 'eager', widths: '360, 540, 720', sizes: '(min-width: 750px) 40vw, 90vw', data-quick-view-image: '' }}
      {%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
    </div>
    <div>
      <h2 id="QuickViewTitle-{{ section.id }}" class="font-heading">{{ product.title | escape }}</h2>
      <div data-quick-view-price>{%- render 'price', product: product, use_variant: true -%}</div>
      <form action="{{ routes.cart_add_url }}" method="post" data-catalog-add-form data-variant-form>
        <input type="hidden" name="id" value="{{ selected_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        {% assign option_prefix = 'Quick-' | append: section.id %}{% render 'product-options', product: product, selected_variant: selected_variant, prefix: option_prefix, view: 'quick' %}
        <button type="submit" class="btn btn--primary" {% unless selected_variant.available %}disabled{% endunless %} data-variant-submit>{% if selected_variant.available %}Add to bag{% else %}Sold out{% endif %}</button>
        <p class="catalog-status" data-catalog-status role="status" aria-live="polite"></p>
        {%- capture variant_data -%}[
          {%- for variant in product.variants -%}
            {"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | json }},"comparePrice":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},"image":{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 720 | json }}{% else %}null{% endif %},"alt":{{ variant.featured_image.alt | default: product.title | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]{%- endcapture -%}
        <div hidden data-variant-data data-variants="{{ variant_data | escape }}"></div>
      </form>
      <a class="btn btn--link" href="{{ product.url }}">View full details</a>
    </div>
  </div>
{%- else -%}<p>This product is unavailable. Browse the collection for more options.</p>{%- endif -%}
{% schema %}
{"name":"Quick view","settings":[]}
{% endschema %}
