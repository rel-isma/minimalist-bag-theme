<section
  id="Hero-{{ section.id }}"
  class="hero-section{% if section.settings.full_height %} hero-section--full-height{% endif %}"
  style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="hero-section__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w"
          >
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '480, 750, 1100, 1600',
            class: 'hero-section__image',
            alt: section.settings.heading
        }}
      </picture>
    {%- else -%}
      <img
        src="{{ 'demo-hero-1100.webp' | asset_url }}"
        srcset="{{ 'demo-hero-750.webp' | asset_url }} 750w, {{ 'demo-hero-1100.webp' | asset_url }} 1100w, {{ 'demo-hero-1600.webp' | asset_url }} 1600w"
        sizes="100vw"
        alt="{{ section.settings.heading | escape }}"
        width="1600"
        height="1067"
        loading="eager"
        fetchpriority="high"
        class="hero-section__image"
      >
    {%- endif -%}
    <div class="hero-section__overlay"></div>
  </div>

  <div class="container hero-section__content-container">
    <div class="hero-section__content text-center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hero-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="hero-section__heading">
        {{ section.settings.heading | escape }}
      </h1>

      {%- if section.settings.subhead != blank -%}
        <p class="hero-section__subhead prose">
          {{ section.settings.subhead | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="hero-section__cta">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary">
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop lifestyle image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile lifestyle image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Full screen height",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Bags and everyday essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quietly essential."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheading",
      "default": "Considered shapes for the things you carry."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "limit": 1
}
{% endschema %}
