<section
  id="Hero-{{ section.id }}"
  class="hero-section{% if section.settings.full_height %} hero-section--full-height{% endif %}"
  style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="hero-section__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w"
          >
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1920, 2400',
            class: 'hero-section__image',
            alt: section.settings.heading
        }}
      </picture>
    {%- else -%}
      <div class="hero-section__placeholder">
        <svg class="placeholder-svg" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <rect width="100%" height="100%" fill="#ECE5DA"></rect>
          <circle cx="50%" cy="45%" r="220" fill="#E2DACD"></circle>
          <path d="M 600,750 Q 960,600 1320,750" fill="none" stroke="#D9D0C3" stroke-width="3"></path>
        </svg>
      </div>
    {%- endif -%}
    <div class="hero-section__overlay"></div>
  </div>

  <div class="container hero-section__content-container">
    <div class="hero-section__content text-center fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hero-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="hero-section__heading">
        {{ section.settings.heading | escape }}
      </h1>

      {%- if section.settings.subhead != blank -%}
        <p class="hero-section__subhead prose">
          {{ section.settings.subhead | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="hero-section__cta">
          <a href="{{ section.settings.button_link }}" class="btn btn--primary">
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop lifestyle image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile lifestyle image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Full screen height",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The Minimalist Shoulder Bag"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quietly Essential. Built to Outlast the Season."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheading",
      "default": "Sculpted in full-grain leather with uncluttered lines. An archetype refined for daily elegance."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore The Bag"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/#ProductSpotlight"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
