{% assign carry_collection = section.settings.collection %}
{% capture carry_cards %}{% assign carry_count = 0 %}{% for suggestion in carry_collection.products %}{% unless suggestion.id == product.id or suggestion.available == false %}{% assign carry_count = carry_count | plus: 1 %}{% render 'product-card', product: suggestion, section_id: section.id, card_index: carry_count %}{% if carry_count >= section.settings.limit %}{% break %}{% endif %}{% endunless %}{% endfor %}{% endcapture %}
{% if carry_count > 0 %}
<section class="carry-edit section-spacing hairline-bottom" data-carry-edit>
  <div class="container"><header class="carry-edit__header"><div><p class="eyebrow">The finishing touches</p><h2 class="section-heading">{{ section.settings.heading | escape }}</h2><p class="text-muted">{{ section.settings.text | escape }}</p></div><a href="{{ carry_collection.url }}" class="btn btn--link">Explore the edit <span aria-hidden="true">↗</span></a></header>
    <div class="carry-edit__grid" style="--carry-columns: {{ carry_count }};">{{ carry_cards }}</div>
    {% if settings.offers_enabled and settings.bundle_offer_enabled and settings.bundle_offer_code != blank %}<p class="carry-edit__note">Pairing your bags? <button class="btn btn--link" type="button" data-offers-open>View offer and terms</button></p>{% endif %}
  </div>
</section>
{% elsif request.design_mode %}<div class="container section-spacing"><p>Select a collection for Complete your carry.</p></div>{% endif %}
{% schema %}
{
  "name": "Complete your carry",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Complete your carry"},
    {"type":"text","id":"text","label":"Text","default":"A wallet for the essentials. A finishing touch for your everyday bag. Find the pieces that work together."},
    {"type":"collection","id":"collection","label":"Pairing collection"},
    {"type":"range","id":"limit","label":"Products to show","min":2,"max":4,"step":1,"default":4}
  ],
  "presets":[{"name":"Complete your carry"}],
  "enabled_on":{"templates":["*"]}
}
{% endschema %}
