<section id="WhyThisBag" class="why-this-bag-section section-spacing hairline-bottom">
  <div class="container">
    <div class="section-header text-center fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subhead != blank -%}
        <p class="text-muted prose" style="margin: 0 auto;">{{ section.settings.subhead | escape }}</p>
      {%- endif -%}
    </div>

    <div class="why-this-bag__grid">
      {%- for block in section.blocks -%}
        <div class="why-this-bag__card fade-up" {{ block.shopify_attributes }}>
          <div class="why-this-bag__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 900px) 25vw, 100vw',
                  widths: '300, 500, 800',
                  class: 'why-this-bag__image',
                  alt: block.settings.title
              }}
            {%- else -%}
              {%- liquid
                case forloop.index
                  when 1
                    assign fallback_img = 'craft-leather.jpg'
                  when 2
                    assign fallback_img = 'craft-slouch.jpg'
                  when 3
                    assign fallback_img = 'craft-stitching.jpg'
                  else
                    assign fallback_img = 'detail-hardware.jpg'
                endcase
              -%}
              <img
                src="{{ fallback_img | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                class="why-this-bag__image"
                width="800"
                height="600"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          <div class="why-this-bag__body">
            <h3 class="why-this-bag__title">{{ block.settings.title | escape }}</h3>
            <p class="why-this-bag__text text-muted">{{ block.settings.text | escape }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why this bag",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Design Principles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Made It"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheading",
      "default": "No extraneous hardware. No conspicuous logos. Just considered proportions and honest materials."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature block",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Feature image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature title",
          "default": "Full-Grain Italian Calfskin"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Sourced from small family-run tanneries in Tuscany. Supple to the touch with a delicate pebble grain that ages gracefully over years of wear."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why this bag",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Full-Grain Italian Calfskin",
            "text": "Sourced from small family-run tanneries in Tuscany. Supple to the touch with a delicate pebble grain that develops a rich patina."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Unstructured Ergonomic Slouch",
            "text": "Drapes naturally under the arm without rigid cardboard stiffeners. Soft yet structured enough to stand on its base when set down."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Custom Solid Brass Hardware",
            "text": "Every buckle and magnetic closure is machined from solid brass and brushed to a warm satin finish that will never peel or rust."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Reinforced Saddle Stitching",
            "text": "Critical stress points are hand-tacked with high-tensile waxed thread, ensuring the shoulder strap remains secure through years of daily commute."
          }
        }
      ]
    }
  ]
}
{% endschema %}
