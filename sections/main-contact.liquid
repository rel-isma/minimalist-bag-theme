{% assign contact_form_id = 'ContactForm-' | append: section.id %}
<section class="main-contact-section section-spacing hairline-bottom">
  <div class="container container--narrow">
    <header class="section-header text-center fade-up">
      <p class="eyebrow">{{ 'templates.contact.form.send' | t }}</p>
      <h1 class="section-heading">{{ section.settings.heading | default: page.title | default: 'Client Correspondence' | escape }}</h1>
      <p class="text-muted prose" style="margin: 0 auto;">
        {{ section.settings.intro | escape }}
      </p>
    </header>

    {%- if page.content != blank -%}
      <div class="prose text-center fade-up" style="margin: 0 auto 3rem auto;">
        {{ page.content }}
      </div>
    {%- endif -%}

    <div class="contact-form-wrap fade-up">
      {%- form 'contact', id: contact_form_id, class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="alert alert--success text-center" tabindex="-1" autofocus style="padding: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-border); margin-bottom: 2rem;">
            <p class="text-accent font-medium">{{ 'templates.contact.form.post_success' | t }}</p>
          </div>
        {%- elsif form.errors -%}
          <div class="alert alert--error" role="alert" tabindex="-1" autofocus style="padding: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-accent); margin-bottom: 2rem;">
            <p class="text-accent font-medium">Please correct the following:</p>
            <ul style="margin-top: 0.5rem; list-style: disc; padding-left: 1.25rem;">
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="contact-fields">
          <div>
            <label for="ContactForm-{{ section.id }}-name" class="form-label">{{ 'templates.contact.form.name' | t }}</label>
            <input
              type="text"
              id="ContactForm-{{ section.id }}-name"
              name="contact[name]"
              class="form-input"
              value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
              autocomplete="name"
              placeholder="Your name"
            >
          </div>

          <div>
            <label for="ContactForm-{{ section.id }}-email" class="form-label">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="ContactForm-{{ section.id }}-email"
              name="contact[email]"
              class="form-input"
              value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
              spellcheck="false"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              aria-required="true"
              placeholder="email@domain.com"
              required
            >
          </div>
        </div>

        <div style="margin-bottom: 1.5rem;">
          <label for="ContactForm-{{ section.id }}-phone" class="form-label">{{ 'templates.contact.form.phone' | t }}</label>
          <input
            type="tel"
            id="ContactForm-{{ section.id }}-phone"
            name="contact[phone]"
            class="form-input"
            value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
            autocomplete="tel"
            placeholder="+1 (555) 000-0000"
          >
        </div>

        <div style="margin-bottom: 2rem;">
          <label for="ContactForm-{{ section.id }}-body" class="form-label">{{ 'templates.contact.form.comment' | t }} <span aria-hidden="true">*</span></label>
          <textarea
            rows="6"
            id="ContactForm-{{ section.id }}-body"
            name="contact[body]"
            class="form-input"
            aria-required="true"
            placeholder="How may our studio assist you?"
            required
          >{{ form.body | escape }}</textarea>
        </div>

        <div class="text-center">
          <button type="submit" class="btn btn--primary" style="min-width: 200px;">
            {{ 'templates.contact.form.send' | t }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Introduction",
      "default": "Questions about a product or order? Send a message to our atelier."
    }
  ],
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "limit": 1
}
{% endschema %}
