{% if product != blank %}
{% assign current_variant = product.selected_or_first_available_variant %}{% assign product_form_id = 'ProductForm-' | append: section.id %}
{% render 'structured-data', product: product %}
<section class="main-product-section section-spacing hairline-bottom" data-main-product data-can-enhance="{% assign picker_blocks = section.blocks | where: 'type', 'variant_picker' %}{% if picker_blocks.size > 0 or product.has_only_default_variant %}true{% else %}false{% endif %}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}">
  <div class="container"><nav class="collection-breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><a href="{{ routes.all_products_collection_url }}">Shop</a><span aria-hidden="true">/</span><span aria-current="page">{{ product.title | escape }}</span></nav>
  <div class="product-spotlight__grid"><div>{% render 'product-media-gallery', product: product %}</div><div class="product-buy-box" data-buy-box>
  {% for block in section.blocks %}{% case block.type %}
    {% when '@app' %}<div {{ block.shopify_attributes }}>{% render block %}</div>
    {% when 'title' %}<div class="product-buy-box__header" {{ block.shopify_attributes }}><p class="eyebrow">{{ settings.brand_name | escape }}</p><h1 class="product-buy-box__title">{{ product.title | escape }}</h1></div>
    {% when 'price' %}<div class="product-buy-box__price-line" data-product-price {{ block.shopify_attributes }}>{% render 'price', product: product, use_variant: true %}</div>
    {% when 'variant_picker' %}<div class="product-enhancement-only" {{ block.shopify_attributes }}>{% assign option_prefix = 'Main-' | append: section.id %}{% render 'product-options', product: product, selected_variant: current_variant, prefix: option_prefix, view: 'product' %}</div>
    {% when 'quantity_selector' %}<div {{ block.shopify_attributes }}><label class="form-label" for="ProductQuantity-{{ section.id }}">Quantity</label><div class="quantity-input-stepper"><button type="button" class="quantity__button product-enhancement-only" data-product-quantity="-1" aria-label="Decrease quantity">−</button><input class="quantity__input" type="number" id="ProductQuantity-{{ section.id }}" name="quantity" min="1" step="1" value="1" form="{{ product_form_id }}"><button type="button" class="quantity__button product-enhancement-only" data-product-quantity="1" aria-label="Increase quantity">+</button></div></div>
    {% when 'buy_buttons' %}<div class="product-buy-box__actions" {{ block.shopify_attributes }}>{% form 'product', product, id: product_form_id, data-catalog-add-form: '', data-product-form: '' %}<label class="form-label product-native-variant" for="ProductVariant-{{ section.id }}">Choose a variant</label><select class="form-input product-native-variant" name="id" id="ProductVariant-{{ section.id }}" data-product-variant-id>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><button class="btn btn--primary btn--full" type="submit" data-product-submit {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</button><p class="catalog-status" data-catalog-status role="status" aria-live="polite"></p>{% if block.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}{{ form | payment_terms }}{% endform %}</div>
    {% when 'description' %}<div class="prose text-muted" {{ block.shopify_attributes }}>{{ product.description }}</div>
    {% when 'collapsible_tab' %}{% capture tab_content %}{% case block.settings.source %}{% when 'material' %}{% if product.metafields.custom.material != blank %}{{ product.metafields.custom.material | metafield_tag }}{% else %}{{ block.settings.content }}{% endif %}{% when 'dimensions' %}{% if product.metafields.custom.dimensions != blank %}{{ product.metafields.custom.dimensions | metafield_tag }}{% else %}{{ block.settings.content }}{% endif %}{% when 'care' %}{% if product.metafields.custom.care != blank %}{{ product.metafields.custom.care | metafield_tag }}{% else %}{{ block.settings.content }}{% endif %}{% else %}{{ block.settings.content }}{% endcase %}{% endcapture %}<div {{ block.shopify_attributes }}>{% assign tab_id = section.id | append: block.id %}{% render 'product-accordion', id: tab_id, title: block.settings.heading, content: tab_content, open_by_default: block.settings.open_by_default %}</div>
    {% when 'custom_liquid' %}<div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
  {% endcase %}{% endfor %}{% render 'product-variant-data', product: product %}</div></div></div>
</section>
{% else %}<section class="section-spacing container"><h1 class="section-heading">Product unavailable</h1><a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">Browse all products</a></section>{% endif %}
{% schema %}
{"name":"Product information","settings":[],"blocks":[{"type":"@app"},{"type":"title","name":"Title","limit":1},{"type":"price","name":"Price","limit":1},{"type":"variant_picker","name":"Variant picker","limit":1},{"type":"quantity_selector","name":"Quantity","limit":1},{"type":"buy_buttons","name":"Buy buttons","limit":1,"settings":[{"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout","default":false}]},{"type":"description","name":"Description","limit":1},{"type":"collapsible_tab","name":"Accordion","settings":[{"type":"text","id":"heading","label":"Heading","default":"Details"},{"type":"select","id":"source","label":"Content source","options":[{"value":"custom","label":"Custom text"},{"value":"material","label":"Material metafield"},{"value":"dimensions","label":"Dimensions metafield"},{"value":"care","label":"Care metafield"}],"default":"custom"},{"type":"richtext","id":"content","label":"Fallback text","default":"<p>Details are being prepared. Contact us with any questions.</p>"},{"type":"checkbox","id":"open_by_default","label":"Open by default","default":false}]},{"type":"custom_liquid","name":"Custom Liquid","settings":[{"type":"liquid","id":"custom_liquid","label":"Custom Liquid"}]}]}
{% endschema %}
