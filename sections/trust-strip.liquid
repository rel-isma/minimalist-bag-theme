{% if section.blocks.size > 0 %}<section class="section-spacing hairline-bottom"><div class="container"><div class="benefits-grid">{% for block in section.blocks %}{% if block.settings.title != blank %}<div {{ block.shopify_attributes }}><h2 class="font-heading">{{ block.settings.title | escape }}</h2><p class="text-muted">{{ block.settings.text | escape }}</p></div>{% endif %}{% endfor %}</div></div></section>{% endif %}
{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add only verified service or product benefits. No default delivery, return or material claims are supplied."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Verified benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Benefits"
    }
  ],
  "enabled_on": {
    "templates": [
      "*"
    ]
  }
}
{% endschema %}
