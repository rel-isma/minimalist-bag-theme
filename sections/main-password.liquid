<div class="container container--narrow text-center" style="padding: 4rem 1.5rem;">
  <p class="eyebrow" style="margin-bottom: 1rem;">Atelier In Preparation</p>
  <h1 class="font-heading" style="font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 1.5rem;">
    {{ settings.brand_name | default: shop.name }}
  </h1>
  <p class="text-muted prose" style="margin: 0 auto 2.5rem auto;">
    {{ shop.password_message | default: 'Our store is in preparation.' }}
  </p>

  <div class="password-form-wrap" style="max-width: 440px; margin: 0 auto; background: var(--color-surface); border: 1px solid var(--color-border); padding: 2rem;">
    <h2 class="label-caps" style="margin-bottom: 1rem; color: var(--color-ink);">Store Access</h2>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <div class="alert alert--error" style="color: var(--color-accent); font-size: 0.8125rem; margin-bottom: 1rem;">
          {{ form.errors.messages.form }}
        </div>
      {%- endif -%}

      <div style="display: flex; gap: 0.5rem;">
        <label for="PasswordInput" class="visually-hidden">Storefront password</label>
        <input
          type="password"
          id="PasswordInput"
          name="password"
          class="form-input"
          placeholder="Enter password"
          required
        >
        <button type="submit" class="btn btn--primary" style="min-width: 90px; padding: 0.75rem 1.25rem;">
          Enter
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}
