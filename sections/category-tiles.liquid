<section class="section-spacing hairline-bottom"><div class="container"><header class="section-header"><h2 class="section-heading">{{ section.settings.heading | escape }}</h2></header><div class="category-grid">
{% for block in section.blocks %}{% assign category = block.settings.collection %}<article {{ block.shopify_attributes }}>{% if category != blank %}<a class="category-tile" href="{{ category.url }}">{% if category.image %}{{ category.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 900', sizes: '(min-width: 990px) 33vw, 50vw' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}<h3 class="font-heading">{{ category.title | escape }}</h3></a>{% else %}<div class="category-tile">{{ 'collection-1' | placeholder_svg_tag }}<h3 class="font-heading">{{ block.settings.label | default: 'Choose a collection' | escape }}</h3>{% if request.design_mode %}<p>Select a collection in this tile.</p>{% endif %}</div>{% endif %}</article>{% endfor %}
</div></div></section>
{% schema %}
{
  "name": "Category tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore by shape"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Empty tile label",
          "default": "Choose a collection"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "*"
    ]
  }
}
{% endschema %}
