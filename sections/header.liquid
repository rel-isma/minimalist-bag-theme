{%- assign navigation_menu = section.settings.menu -%}
<div data-header-section>
  <header class="site-header{% if section.settings.enable_transparent_header and template.name == 'index' %} is-transparent{% endif %}" data-header>
    <div class="container">
      <div class="site-header__inner">
        <div class="header-leading">
          <nav class="site-header__nav" aria-label="Main navigation">{% render 'navigation-tree', menu: navigation_menu, mode: 'desktop', mega_menu_title: section.settings.mega_menu_title %}</nav>
          <button type="button" class="mobile-menu-toggle" data-mobile-menu-toggle aria-expanded="false" aria-controls="MobileNav-{{ section.id }}" aria-label="Open menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
        </div>
        <div class="site-header__logo">
          <a href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: shop.name | escape }} — Home">
            {%- if section.settings.logo != blank -%}
              {{ section.settings.logo | image_url: width: 480 | image_tag: loading: 'eager', widths: '80, 140, 240, 480', sizes: '240px', class: 'site-header__logo-image', alt: shop.name }}
            {%- else -%}<span class="site-header__logo-text">{{ settings.brand_name | default: shop.name | escape }}</span>{%- endif -%}
          </a>
        </div>
        <div class="site-header__actions">
          <a class="header-icon" href="{{ routes.search_url }}" data-header-search-open aria-label="Search" aria-haspopup="dialog" aria-controls="HeaderSearch-{{ section.id }}">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
          </a>
          {%- if shop.customer_accounts_enabled -%}
            <a class="header-icon header-account" href="{{ routes.account_url }}" aria-label="Account"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></svg></a>
          {%- endif -%}
          <a href="{{ routes.cart_url }}" class="site-header__cart-trigger" {% if settings.cart_type != 'page' %}data-cart-drawer-trigger{% endif %} aria-label="Bag, {{ cart.item_count }} items">
            {%- render 'icon-cart' -%}
            <span class="cart-count-badge" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
          </a>
        </div>
      </div>
      <details class="header-mobile-fallback"><summary class="site-header__nav-link">Menu</summary><nav aria-label="Mobile navigation">{% render 'navigation-tree', menu: navigation_menu, mode: 'mobile' %}</nav>{% if shop.customer_accounts_enabled %}<a class="mobile-nav-link" href="{{ routes.account_url }}">Account</a>{% endif %}</details>
    </div>
  </header>
  <dialog id="MobileNav-{{ section.id }}" class="mobile-nav-drawer" data-mobile-nav-drawer aria-label="Menu">
    <div class="mobile-nav-header"><span class="site-header__logo-text">{{ settings.brand_name | default: shop.name | escape }}</span><button type="button" class="btn btn--link" data-header-dialog-close aria-label="Close menu">Close</button></div>
    <nav aria-label="Mobile navigation">{% render 'navigation-tree', menu: navigation_menu, mode: 'mobile' %}</nav>
    {% if shop.customer_accounts_enabled %}<a class="mobile-nav-link" href="{{ routes.account_url }}">Account</a>{% endif %}
  </dialog>
  <dialog id="HeaderSearch-{{ section.id }}" class="catalog-dialog header-search-dialog" data-header-search-dialog aria-labelledby="SearchTitle-{{ section.id }}">
    <div class="catalog-dialog__header"><h2 id="SearchTitle-{{ section.id }}" class="font-heading">Search the atelier</h2><button type="button" class="btn btn--link" data-header-dialog-close aria-label="Close search">Close</button></div>
    {%- assign search_input_id = 'HeaderSearchInput-' | append: section.id -%}
    {% render 'search-form', input_id: search_input_id, predictive: section.settings.enable_predictive_search %}
  </dialog>
</div>
<style>#shopify-section-{{ section.id }} .site-header__logo-image { width: {{ section.settings.logo_width }}px; max-width: 100%; height: auto; }</style>
{% schema %}
{"name":"Header","class":"atelier-header-section","settings":[{"type":"image_picker","id":"logo","label":"Logo image"},{"type":"range","id":"logo_width","min":80,"max":240,"step":10,"unit":"px","label":"Custom logo width","default":140},{"type":"link_list","id":"menu","label":"Navigation menu","info":"Select Main menu. Nested links appear in desktop dropdowns and the mobile menu. An empty menu shows Shop all."},{"type":"text","id":"mega_menu_title","label":"Image menu link title","default":"Shop","info":"Matches a top-level menu with nested collection links. Images use collection images or the first product image."},{"type":"checkbox","id":"enable_transparent_header","label":"Transparent header over home hero","default":false},{"type":"checkbox","id":"enable_predictive_search","label":"Enable predictive search","default":true}]}
{% endschema %}
