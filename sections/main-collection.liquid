<section class="main-collection-section section-spacing hairline-bottom">
  <div class="container">
    <header class="section-header text-center fade-up">
      <p class="eyebrow">{{ settings.brand_name | default: 'Our Atelier' }}</p>
      <h1 class="section-heading">{{ collection.title | default: 'The Collection' | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="text-muted prose" style="margin: 0 auto;">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </header>

    <div class="collection-products-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; max-width: 900px; margin: 0 auto;">
      {%- for product in collection.products -%}
        <div class="collection-product-card text-center fade-up">
          <div style="aspect-ratio: 4/5; background: var(--color-surface); margin-bottom: 1.5rem; overflow: hidden; border-radius: var(--radius-sm);">
            {%- if product.featured_media != blank -%}
              <a href="{{ product.url }}">
                {{
                  product.featured_media
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', alt: product.title, style: 'width: 100%; height: 100%; object-fit: cover;'
                }}
              </a>
            {%- else -%}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                <span class="label-caps">The Shoulder Bag</span>
              </div>
            {%- endif -%}
          </div>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 0.5rem;">
            <a href="{{ product.url }}">{{ product.title | escape }}</a>
          </h2>
          <div style="margin-bottom: 1.5rem;">
            {%- render 'price', product: product -%}
          </div>
          <a href="{{ product.url }}" class="btn btn--primary">
            View Details
          </a>
        </div>
      {%- else -%}
        <!-- Single product fallback card -->
        <div class="collection-product-card text-center fade-up" style="grid-column: 1 / -1; max-width: 480px; margin: 0 auto;">
          <div style="aspect-ratio: 4/5; background: var(--color-surface); margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <span class="label-caps">The Minimalist Shoulder Bag</span>
          </div>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 0.5rem;">
            {{ settings.product_name | default: 'The Minimalist Shoulder Bag' }}
          </h2>
          <div style="margin-bottom: 1.5rem;">
            <span class="price-item font-medium">$295.00</span>
          </div>
          <a href="{{ routes.root_url }}#ProductSpotlight" class="btn btn--primary">
            Shop The Bag
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection products",
  "settings": []
}
{% endschema %}
