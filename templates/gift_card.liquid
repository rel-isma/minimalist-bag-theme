{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Gift Card &ndash; {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-giftcard" style="background-color: var(--color-bg); padding: 4rem 1.5rem; text-align: center;">
    <div class="container container--narrow">
      <p class="eyebrow" style="margin-bottom: 1rem;">{{ shop.name }}</p>
      <h1 class="font-heading" style="font-size: 2.5rem; margin-bottom: 1.5rem;">Your Gift Card</h1>
      <div style="background: var(--color-surface); border: 1px solid var(--color-border); padding: 2.5rem; max-width: 440px; margin: 0 auto 2rem auto;">
        <p class="label-caps" style="margin-bottom: 0.5rem;">Current Balance</p>
        <p class="font-medium" style="font-size: 2rem; color: var(--color-ink); margin-bottom: 1.5rem;">
          {{ gift_card.balance | money }}
        </p>
        <div style="background: var(--color-bg); padding: 1rem; border: 1px dashed var(--color-border); font-family: monospace; font-size: 1.25rem; letter-spacing: 0.1em;">
          {{ gift_card.code | format_code }}
        </div>
      </div>
      <a href="{{ shop.url }}" class="btn btn--primary">Visit Store</a>
    </div>
  </body>
</html>
