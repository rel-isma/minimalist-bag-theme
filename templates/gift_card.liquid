{% layout none %}
<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Gift card — {{ settings.brand_name | default: shop.name | escape }}</title>{{ 'base.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head><body class="template-giftcard"><main class="container container--narrow section-spacing text-center"><p class="eyebrow">{{ settings.brand_name | default: shop.name | escape }}</p><h1 class="section-heading">Your gift card</h1>{% if gift_card != blank %}<div class="prose" style="margin-inline:auto;"><p>Current balance: <strong>{{ gift_card.balance | money }}</strong></p>{% if gift_card.expired or gift_card.enabled == false %}<p>This gift card is no longer available.</p>{% else %}<p>Use this code at checkout:</p><p class="font-medium">{{ gift_card.code | format_code }}</p>{% endif %}{% if gift_card.expires_on %}<p>Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>{% endif %}</div>{% else %}<p>This gift card is unavailable.</p>{% endif %}<a class="btn btn--primary" href="{{ routes.root_url }}">Visit the store</a><button class="btn btn--secondary" type="button" onclick="window.print()">Print gift card</button></main></body></html>
